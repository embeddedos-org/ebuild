project:
  name: {{PROJECT_NAME}}
  version: 0.1.0

workspace:
  backend: ninja
  build_dir: build

toolchain:
  target: {{TOOLCHAIN}}

targets:
  - name: {{PROJECT_NAME}}
    type: executable
    sources:
      - src/main.c
    includes:
      - src/
    uses:
      - eos
    depends: []

  - name: test_{{PROJECT_NAME}}
    type: test
    sources:
      - tests/test_main.c
    includes:
      - src/
    uses:
      - eos
    depends: []
