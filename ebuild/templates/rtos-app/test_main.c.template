/**
 * {{PROJECT_NAME}} — smoke test
 *
 * Generated by: ebuild new {{PROJECT_NAME}}
 *
 * Runs on the host via `ebuild test`. Its job is to fail when the build
 * wiring is wrong -- a missing EoS checkout, a bad include path, a link-order
 * problem -- so that those are caught here rather than on the bench.
 *
 * It deliberately does not assert that eos_hal_init() succeeds. A host build
 * has no HAL backend registered, so eos_hal_init() returns -1 by design; the
 * board build is where that call is expected to return 0.
 */

#include <eos/hal.h>
#include <stdio.h>

static int failures = 0;

#define CHECK(cond)                                                    \
    do {                                                               \
        if (!(cond)) {                                                 \
            printf("FAIL %s:%d: %s\n", __FILE__, __LINE__, #cond);     \
            failures++;                                                \
        }                                                              \
    } while (0)

int main(void)
{
    /* Linking proves the EoS headers and libraries resolved. Calling proves
     * the dispatch layer is present and does not fault with no backend. */
    int status = eos_hal_init();
    printf("eos_hal_init() -> %d%s\n", status,
           status == 0 ? "" : " (no backend on a host build — expected)");

    /* The HAL must tolerate calls with no backend rather than crashing:
     * that is what lets this test run at all on a development machine. */
    eos_gpio_config_t led = {
        .pin   = 13,
        .mode  = EOS_GPIO_OUTPUT,
        .pull  = EOS_GPIO_PULL_NONE,
        .speed = EOS_GPIO_SPEED_LOW,
    };
    eos_gpio_init(&led);
    eos_gpio_toggle(led.pin);

    /* A tick source is the one thing every board must provide; on the host
     * it is monotonic and must not run backwards. */
    uint32_t t0 = eos_get_tick_ms();
    uint32_t t1 = eos_get_tick_ms();
    CHECK(t1 >= t0);

    if (failures == 0) {
        printf("ok — {{PROJECT_NAME}} smoke test passed\n");
        return 0;
    }
    printf("%d check(s) failed\n", failures);
    return 1;
}
